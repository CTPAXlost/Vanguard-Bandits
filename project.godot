; Vanguard Bandits Remaster 1.9.19 — восстановленные сюжетные диалоги, видимая миссия VI, полностью открытые проходы, полный магазин; original ATAC skins on Skeleton3D для старых машин и цельные full-body ATAC королевств
; Engine target: Godot 4.6.3 stable

config_version=5

[application]
config/name="Vanguard Bandits Remaster"
config/version="1.9.20"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=60
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=6900

[display]
window/vsync/vsync_mode=1
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2

[autoload]
PerformanceGuard="*res://scripts/performance_guard.gd"
GameDatabase="*res://scripts/game_database.gd"
CampaignState="*res://scripts/campaign_state.gd"
